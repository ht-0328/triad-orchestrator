{
  "_comment": "Antigravity CLI(agy)は現行の公式ドキュメント上、プロジェクト単位の設定パスを提供していない。実際の適用先はユーザー単位の ~/.gemini/antigravity-cli/settings.json であり、本ファイルはその内容を利用者ごとに手動反映するための共有テンプレートである。更新したらAGENTS.mdの「コマンドとファイル変更の確認方針」とこの内容を同時に見直すこと。",
  "permissions": {
    "allow": [
      "command(pwd)",
      "command(ls)",
      "command(cat)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(stat)",
      "command(file)",
      "command(readlink)",
      "command(realpath)",
      "command(rg)",
      "command(sed -n)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git rev-parse)",
      "command(git ls-files)",
      "command(git check-ignore)",
      "command(git branch --show-current)",
      "command(command -v)",
      "command(type)",
      "command(git --help)",
      "command(git --version)",
      "command(docker --help)",
      "command(docker --version)",
      "command(docker compose --help)",
      "command(docker compose version)",
      "command(python3 --help)",
      "command(python3 --version)",
      "command(bin/triad doctor)",
      "command(bin/triad status)",
      "command(bin/triad --help)",
      "command(bin/triad-new --help)",
      "command(docker compose config)",
      "command(docker compose ps)",
      "command(docker compose logs)",
      "command(docker compose images)",
      "command(docker compose top)",
      "command(docker compose build)",
      "command(docker compose run --rm test)",
      "command(docker compose up -d)",
      "command(docker compose stop)",
      "command(docker compose down)",
      "command(python3 -m unittest discover -s tests)"
    ],
    "deny": [
      "command(git push)",
      "command(git rebase)",
      "command(git filter-branch)",
      "command(git reset --hard)",
      "command(docker compose down -v)",
      "command(docker compose down --volumes)"
    ]
  }
